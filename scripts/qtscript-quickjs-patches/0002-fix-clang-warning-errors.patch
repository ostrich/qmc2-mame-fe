diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,2 +10,12 @@ find_package(Qt6 ${QT_REPO_MODULE_VERSION} CONFIG REQUIRED
 )
+# Recent macOS SDKs no longer ship an AGL link stub. QtGui already records its
+# runtime dependency on AGL, so do not propagate the obsolete framework when
+# linking this out-of-tree module.
+if(APPLE AND TARGET WrapOpenGL::WrapOpenGL)
+    get_target_property(wrap_opengl_libraries WrapOpenGL::WrapOpenGL INTERFACE_LINK_LIBRARIES)
+    if(wrap_opengl_libraries)
+        list(FILTER wrap_opengl_libraries EXCLUDE REGEX "AGL(\\.framework)?$")
+        set_property(TARGET WrapOpenGL::WrapOpenGL PROPERTY INTERFACE_LINK_LIBRARIES "${wrap_opengl_libraries}")
+    endif()
+endif()
 find_package(Threads REQUIRED)
