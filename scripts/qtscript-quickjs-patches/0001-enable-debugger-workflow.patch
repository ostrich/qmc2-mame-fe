+// QuickJS-NG intentionally compiles the debugger statement as a no-op.  Keep
+// the source offsets and line numbers intact while redirecting it to the
+// private hook installed by QtScriptTools.  The small scanner deliberately
+// skips strings, templates and comments.
+static QByteArray enableDebuggerStatements(const QByteArray &source)
+{
+    static constexpr char hook[] = "$QSDbg$_()";
+    QByteArray result = source;
+    enum State { Code, SingleQuote, DoubleQuote, Template, LineComment, BlockComment } state = Code;
+    bool escaped = false;
+    for (qsizetype i = 0; i < result.size(); ++i) {
+        const char ch = result.at(i);
+        const char next = i + 1 < result.size() ? result.at(i + 1) : '\0';
+        if (state == LineComment) {
+            if (ch == '\n') state = Code;
+            continue;
+        }
+        if (state == BlockComment) {
+            if (ch == '*' && next == '/') { state = Code; ++i; }
+            continue;
+        }
+        if (state != Code) {
+            if (escaped) { escaped = false; continue; }
+            if (ch == '\\') { escaped = true; continue; }
+            if ((state == SingleQuote && ch == '\'') || (state == DoubleQuote && ch == '"')
+                || (state == Template && ch == '`')) state = Code;
+            continue;
+        }
+        if (ch == '/' && next == '/') { state = LineComment; ++i; continue; }
+        if (ch == '/' && next == '*') { state = BlockComment; ++i; continue; }
+        if (ch == '\'') { state = SingleQuote; continue; }
+        if (ch == '"') { state = DoubleQuote; continue; }
+        if (ch == '`') { state = Template; continue; }
+        if (i + 8 <= result.size() && result.mid(i, 8) == "debugger") {
+            const auto identifier = [](char c) {
+                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+                    || (c >= '0' && c <= '9') || c == '_' || c == '$';
+            };
+            const bool before = i > 0 && identifier(result.at(i - 1));
+            const bool after = i + 8 < result.size() && identifier(result.at(i + 8));
+            if (!before && !after) {
+                result.replace(i, 8, hook);
+                i += int(sizeof(hook)) - 2;
+            }
+        }
+    }
+    return result;
+}
