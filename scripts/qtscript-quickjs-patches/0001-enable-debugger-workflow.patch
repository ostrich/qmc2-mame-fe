+void QScriptEngineDebugger::_q_quickjsPause()
+{
+    Q_D(QScriptEngineDebugger);
+    if (!d->engine) return;
+    d->source = d->engine->property("_q_qtscript_source").toString();
+    if (QWidget *code = widget(CodeWidget))
+        if (auto *editor = code->findChild<QPlainTextEdit *>()) editor->setPlainText(d->source);
+    do {
+        d->stepAgain = false;
+        d->state = SuspendedState;
+        for (auto &action : d->actions) if (action) action->setEnabled(true);
+        emit evaluationSuspended();
+        QEventLoop loop;
+        d->pauseLoop = &loop;
+        loop.exec();
+        d->pauseLoop.clear();
+        d->state = RunningState;
+        for (int actionType : { int(ContinueAction), int(StepIntoAction),
+                               int(StepOverAction), int(StepOutAction) })
+            if (d->actions[size_t(actionType)]) d->actions[size_t(actionType)]->setEnabled(false);
+        emit evaluationResumed();
+    } while (d->stepAgain && d->engine);
 }
 
